# Copy to .env.local for local development. Never commit real secrets.
# None of these values are secret: they are public links that appear in the page.
# Leave a value empty while it is still pending. The site will show a
# "pending" notice in review mode and hide the integration in production.

# Official Tebra online scheduling URL supplied by the practice (https only).
NEXT_PUBLIC_TEBRA_SCHEDULER_URL=

# Tebra patient portal sign in URL (may differ from the scheduling URL).
NEXT_PUBLIC_TEBRA_PORTAL_URL=

# Confirmed online payment URL, only once the practice confirms how payments work.
NEXT_PUBLIC_PAYMENT_URL=

# Public site URL used for metadata, for example https://attentivemedcare.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to true on development and preview builds to show pending content notes.
# Must be false (or empty) for the live launch.
NEXT_PUBLIC_REVIEW_MODE=true
